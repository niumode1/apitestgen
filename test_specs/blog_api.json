{
  "openapi": "3.0.3",
  "info": {
    "title": "Blog API",
    "description": "博客系统 API — 文章/评论/标签管理",
    "version": "1.0.0"
  },
  "servers": [{"url": "http://localhost:9001/api/v1"}],
  "paths": {
    "/articles": {
      "get": {
        "summary": "获取文章列表",
        "tags": ["articles"],
        "parameters": [
          {"name": "page", "in": "query", "schema": {"type": "integer", "minimum": 1, "default": 1}},
          {"name": "size", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 100, "default": 20}},
          {"name": "tag", "in": "query", "schema": {"type": "string"}},
          {"name": "status", "in": "query", "schema": {"type": "string", "enum": ["draft", "published", "archived"]}}
        ],
        "responses": {
          "200": {"description": "文章列表", "content": {"application/json": {"schema": {"type": "object", "properties": {
            "items": {"type": "array", "items": {"$ref": "#/components/schemas/Article"}},
            "total": {"type": "integer"}
          }}}}}
        }
      },
      "post": {
        "summary": "创建文章",
        "tags": ["articles"],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ArticleCreate"}}}},
        "responses": {
          "201": {"description": "创建成功", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Article"}}}},
          "422": {"description": "参数校验失败"}
        }
      }
    },
    "/articles/{id}": {
      "get": {
        "summary": "获取文章详情",
        "tags": ["articles"],
        "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "integer", "format": "int64"}}],
        "responses": {
          "200": {"description": "OK", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Article"}}}},
          "404": {"description": "不存在"}
        }
      },
      "put": {
        "summary": "更新文章",
        "tags": ["articles"],
        "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "integer"}}],
        "requestBody": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/ArticleUpdate"}}}},
        "responses": {"200": {"description": "OK"}, "404": {"description": "不存在"}}
      },
      "delete": {
        "summary": "删除文章",
        "tags": ["articles"],
        "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "integer"}}],
        "responses": {"200": {"description": "已删除"}, "404": {"description": "不存在"}}
      }
    },
    "/articles/{id}/comments": {
      "get": {
        "summary": "获取文章评论",
        "tags": ["comments"],
        "parameters": [
          {"name": "id", "in": "path", "required": true, "schema": {"type": "integer"}},
          {"name": "page", "in": "query", "schema": {"type": "integer", "default": 1}}
        ],
        "responses": {"200": {"description": "评论列表"}}
      },
      "post": {
        "summary": "添加评论",
        "tags": ["comments"],
        "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "integer"}}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["content", "author"], "properties": {
          "content": {"type": "string", "minLength": 1, "maxLength": 1000},
          "author": {"type": "string", "minLength": 1, "maxLength": 50},
          "email": {"type": "string", "format": "email"}
        }}}}},
        "responses": {"201": {"description": "评论成功"}, "422": {"description": "校验失败"}}
      }
    },
    "/tags": {
      "get": {
        "summary": "获取所有标签",
        "tags": ["tags"],
        "responses": {"200": {"description": "标签列表"}}
      }
    },
    "/search": {
      "get": {
        "summary": "搜索文章",
        "tags": ["search"],
        "parameters": [
          {"name": "q", "in": "query", "required": true, "schema": {"type": "string", "minLength": 1}},
          {"name": "sort", "in": "query", "schema": {"type": "string", "enum": ["relevance", "date", "views"]}}
        ],
        "responses": {"200": {"description": "搜索结果"}}
      }
    }
  },
  "components": {
    "schemas": {
      "Article": {
        "type": "object",
        "properties": {
          "id": {"type": "integer", "format": "int64"},
          "title": {"type": "string", "minLength": 1, "maxLength": 200},
          "content": {"type": "string"},
          "summary": {"type": "string", "maxLength": 500},
          "tags": {"type": "array", "items": {"type": "string"}},
          "status": {"type": "string", "enum": ["draft", "published", "archived"]},
          "views": {"type": "integer", "minimum": 0},
          "created_at": {"type": "string", "format": "date-time"}
        }
      },
      "ArticleCreate": {
        "type": "object",
        "required": ["title", "content"],
        "properties": {
          "title": {"type": "string", "minLength": 1, "maxLength": 200},
          "content": {"type": "string", "minLength": 1},
          "summary": {"type": "string", "maxLength": 500},
          "tags": {"type": "array", "items": {"type": "string"}}
        }
      },
      "ArticleUpdate": {
        "type": "object",
        "properties": {
          "title": {"type": "string", "minLength": 1, "maxLength": 200},
          "content": {"type": "string"},
          "summary": {"type": "string"},
          "tags": {"type": "array", "items": {"type": "string"}},
          "status": {"type": "string", "enum": ["draft", "published", "archived"]}
        }
      }
    }
  }
}
